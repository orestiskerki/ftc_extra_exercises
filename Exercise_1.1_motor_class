class Motor {
    String name;
    int power;

    Motor(String name, int power) {
        this.name = name;
        this.power = power;
    }
 
    void run() {
    System.out.println (name + " is running at " + power);
    }
}

class Main {
    public static void main (String[] args){
        Motor motor1 = new Motor ("right motor", 50);
        Motor motor2 = new Motor ("left motor", -50);
        
        motor1.run();
        motor2.run();
    }
}
